# ============================================
# Play Video-Streaming Platform - Environment
# ============================================
# Copy this to .env and fill in your values

# Node Environment
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://play:play123@localhost:5432/play

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_URL=amqp://play:play123@localhost:5672

# ============================================
# MINIO / S3 (Object Storage)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=playadmin
MINIO_SECRET_KEY=playadmin123
MINIO_BUCKET=play-videos
MINIO_USE_SSL=false

# ============================================
# MEILISEARCH (Search)
# ============================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=play-search-key

# ============================================
# AUTH / JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
AUTH_SECRET=your-auth-secret-for-tokens-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ============================================
# CLIENT-SIDE (NEXT_PUBLIC_*) & CORS
# These are exposed to the browser!
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_APP_NAME=Play
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS - comma-separated allowed origins (empty = allow all in dev)
# In production, set: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# ============================================
# MICROSERVICE PORTS (for reference)
# ============================================
# USER_SERVICE_PORT=4002
# VIDEO_SERVICE_PORT=4003
# TRANSCODER_SERVICE_PORT=4005
# ENGAGEMENT_SERVICE_PORT=4006
# SEARCH_SERVICE_PORT=4009
# FEED_SERVICE_PORT=4010
# NOTIFICATION_SERVICE_PORT=4011
