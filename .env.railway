# ============================================
# Play Video-Streaming Platform - Production Environment
# ============================================
# Railway Deployment Configuration

# Node Environment
NODE_ENV=production

# ============================================
# DATABASE (Railway Postgres Plugin)
# ============================================
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ============================================
# REDIS (Railway Redis Plugin)
# ============================================
REDIS_URL=${{Redis.REDIS_URL}}

# ============================================
# RABBITMQ (CloudAMQP or External)
# ============================================
# Get this from CloudAMQP dashboard after signup
# Free tier: https://customer.cloudamqp.com/instance
RABBITMQ_URL=amqps://username:password@host/vhost

# ============================================
# MINIO / S3 (Cloudflare R2 or AWS S3)
# ============================================
# Option 1: Cloudflare R2 (Recommended)
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
MINIO_ENDPOINT=<account_id>.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_ACCESS_KEY=<your_r2_access_key>
MINIO_SECRET_KEY=<your_r2_secret_key>
MINIO_BUCKET=play-videos
MINIO_USE_SSL=true

# Option 2: AWS S3
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_PORT=443
# MINIO_ACCESS_KEY=<your_aws_access_key>
# MINIO_SECRET_KEY=<your_aws_secret_key>
# MINIO_BUCKET=play-videos
# MINIO_USE_SSL=true

# Public URL for video access (R2 custom domain or CloudFront)
NEXT_PUBLIC_MINIO_URL=https://cdn.yourdomain.com

# ============================================
# MEILISEARCH (Search Engine)
# ============================================
# Option 1: Deploy on Railway
MEILISEARCH_URL=http://${{meilisearch.RAILWAY_PRIVATE_DOMAIN}}:7700

# Option 2: Meilisearch Cloud
# MEILISEARCH_URL=https://ms-xxxxxx.meilisearch.io

# Generate a secure key: openssl rand -base64 32
MEILISEARCH_KEY=<generate_secure_master_key_32_chars>

# ============================================
# AUTH / JWT (Generate Strong Secrets!)
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=<generate_random_64_char_string>
JWT_EXPIRES_IN=7d
AUTH_SECRET=<generate_random_64_char_string>
NEXTAUTH_SECRET=<generate_random_64_char_string>
INTERNAL_SERVICE_SECRET=<generate_random_64_char_string>

# Client URLs (Railway auto-assigns domains)
NEXTAUTH_URL=https://${{client.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_APP_URL=https://${{client.RAILWAY_PUBLIC_DOMAIN}}

# ============================================
# SERVICE URLs (Railway Internal DNS)
# ============================================
# Railway provides internal DNS: <service-name>.railway.internal
# Use Railway variables for auto-discovery

USER_SERVICE_URL=http://${{user-service.RAILWAY_PRIVATE_DOMAIN}}:4001
VIDEO_SERVICE_URL=http://${{video-service.RAILWAY_PRIVATE_DOMAIN}}:4003
ENGAGEMENT_SERVICE_URL=http://${{engagement-service.RAILWAY_PRIVATE_DOMAIN}}:4006
SEARCH_SERVICE_URL=http://${{search-service.RAILWAY_PRIVATE_DOMAIN}}:4009
FEED_SERVICE_URL=http://${{feed-service.RAILWAY_PRIVATE_DOMAIN}}:4010
NOTIFICATION_SERVICE_URL=http://${{notification-service.RAILWAY_PRIVATE_DOMAIN}}:4011

# ============================================
# CLIENT-SIDE (NEXT_PUBLIC_*) & CORS
# ============================================
NEXT_PUBLIC_API_URL=https://${{user-service.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_WS_URL=wss://${{video-service.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_APP_NAME=Play

# CORS - Set to your client domain
ALLOWED_ORIGINS=https://${{client.RAILWAY_PUBLIC_DOMAIN}}

# ============================================
# OPTIONAL: Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# OPTIONAL: OAuth Providers
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=<get_from_google_cloud_console>
GOOGLE_CLIENT_SECRET=<get_from_google_cloud_console>

# GitHub OAuth  
GITHUB_CLIENT_ID=<get_from_github_developer_settings>
GITHUB_CLIENT_SECRET=<get_from_github_developer_settings>

# ============================================
# OPTIONAL: FFmpeg Configuration (Transcoder)
# ============================================
FFMPEG_THREADS=4

# ============================================
# NOTES FOR RAILWAY DEPLOYMENT
# ============================================
# 1. Replace all ${{variable}} with actual Railway service references
# 2. Generate strong random secrets using: openssl rand -base64 64
# 3. Setup CloudAMQP account: https://customer.cloudamqp.com
# 4. Setup Cloudflare R2: https://dash.cloudflare.com/r2
# 5. Configure CORS origins after getting Railway public domains
# 6. Run migrations: railway run pnpm db:migrate
# 7. Seed admin: railway run pnpm tsx packages/database/src/seed-admin.ts
